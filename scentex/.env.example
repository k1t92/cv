# PostgreSQL connection (docker-compose.yml provides this one)
DATABASE_URL="postgresql://scentex:scentex@localhost:5432/scentex?schema=public"
# Fallback EUR→PLN rate, used only until the first NBP reference rate is fetched (npm run engine:fx)
EUR_PLN_RATE="4.25"
# Public origin, used for sitemap / Open Graph
SITE_URL="http://localhost:3000"

# Admin panel password (12+ characters). The panel is disabled while this is empty.
ADMIN_TOKEN=""
